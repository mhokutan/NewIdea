{
  "expo": {
    "name": "PromoVote",
    "slug": "promovote",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "promovote",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.miapera.promovote",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:promovote.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.miapera.promovote",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_FINGERPRINT",
        "android.permission.DUMP"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0a0a",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-video",
      "expo-secure-store",
      "expo-localization",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "PromoVote uses your photos and videos only when you choose a profile picture, a banner or a promo video to upload.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0a0a0a",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1312e509-fef9-487f-9478-f1b95f1678af"
      }
    },
    "owner": "mhokutan"
  }
}
