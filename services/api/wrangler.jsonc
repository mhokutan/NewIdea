{
  // PromoVote API: https://api.promovote.com
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "promovote-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "api.promovote.com", "custom_domain": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "promovote-db", "database_id": "b6a6a86f-5e7e-48fe-9ad1-2a29b1222a31", "migrations_dir": "migrations" }
  ],
  "triggers": { "crons": ["17 4 * * *"] },
  "vars": { "API_URL": "https://api.promovote.com" },
  // Secrets (set with `npx wrangler secret put NAME`, never commit): BETTER_AUTH_SECRET, REVENUECAT_WEBHOOK_AUTH
  // Email sending binding is added once Email Sending is enabled for promovote.com:
  // "send_email": [{ "name": "EMAIL" }]
  "observability": { "enabled": true }
}
