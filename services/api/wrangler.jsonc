{
  // PromoVote API: https://api.promovote.com
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "promovote-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [{ "pattern": "api.promovote.com", "custom_domain": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "promovote-db", "database_id": "b6a6a86f-5e7e-48fe-9ad1-2a29b1222a31", "migrations_dir": "migrations" }
  ],
  // Profile photos. Uncomment after R2 is enabled in the Cloudflare dashboard and the bucket exists:
  //   npx wrangler r2 bucket create promovote-media
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "promovote-media" }],
  "triggers": { "crons": ["17 4 * * *"] },
  // 60 writes per minute per IP on /v1 (votes, saves, follows, events, reports).
  "ratelimits": [{ "name": "WRITE_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  "vars": {
    "API_URL": "https://api.promovote.com",
    "APPLE_BUNDLE_ID": "com.miapera.promovote",
    // Google OAuth client ids (iOS, Android, web), comma separated. Filled in when the founder creates them.
    "GOOGLE_CLIENT_IDS": "",
    // App store review test account (email code sign in). Its fixed code is the secret REVIEW_CODE.
    "REVIEW_EMAIL": "review@promovote.com"
  },
  // Secrets (set with `npx wrangler secret put NAME`, never commit): BETTER_AUTH_SECRET, REVIEW_CODE
  // Email sending binding is added once Email Sending is enabled for promovote.com:
  // "send_email": [{ "name": "EMAIL" }]
  "observability": { "enabled": true }
}
